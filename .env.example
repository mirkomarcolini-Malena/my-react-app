# SAP Business One – Service Layer
# Copia questo file in ".env.local" e compila con i tuoi valori.
#
# ATTENZIONE: le variabili VITE_* finiscono nel bundle del browser.
# Per ambienti di produzione con dati sensibili, usa un backend proxy
# che non esponga le credenziali al client.

# URL base del server SAP Business One (senza slash finale)
VITE_SAP_URL=https://tuo-server-sap:50000

# Database azienda SAP (CompanyDB)
VITE_SAP_COMPANY=NomeAziendaSAP

# Credenziali utente SAP
VITE_SAP_USER=manager
VITE_SAP_PASSWORD=password
