# SQL Server SAP Business One – connessione diretta
# Copia questo file in ".env.local" e compila con i tuoi valori.
# ".env.local" è ignorato da git (*.local in .gitignore).
#
# NOTA: queste variabili NON hanno il prefisso VITE_ → non finiscono nel bundle
# del browser. Sono usate solo dal dev-server Vite (lato Node.js).

SQL_SERVER=192.168.10.17
SQL_DATABASE=SBO_MELONI_TEST
SQL_USER=MTH-Client
SQL_PASSWORD=cambia-questa-password
